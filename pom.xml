<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.exlirixsoftware</groupId>
    <artifactId>tessel-fx-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>TesselFX</name>
    <description>A modern, themeable design system for JavaFX, matching Tessel.NET, Tessel4J and Tessel.js.</description>
    <url>https://github.com/exlirixsoftware/TesselFX</url>
    <inceptionYear>2026</inceptionYear>

    <!-- Maven Central rejects a release whose POM lacks the name, description, url, license, developer and scm entries. -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>exlirixsoftware</id>
            <name>Jurca Alexandru-Cristian</name>
            <email>exlirixsoftware@gmail.com</email>
            <organization>EXLIRIX Software</organization>
            <organizationUrl>https://github.com/exlirixsoftware</organizationUrl>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/exlirixsoftware/TesselFX.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exlirixsoftware/TesselFX.git</developerConnection>
        <url>https://github.com/exlirixsoftware/TesselFX</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/exlirixsoftware/TesselFX/issues</url>
    </issueManagement>

    <modules>
        <module>tessel-fx</module>
        <module>tessel-gallery</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            JavaFX 26 is the release that goes with JDK 26 (the JDK this project is built with). The library itself only
            uses API that exists since JavaFX 21 and its class files target Java 17, so it also works with older JavaFX
            versions: build against one with e.g. -Djavafx.version=21.0.11 (JavaFX 21 needs JDK 17+, JavaFX 26 needs JDK 24+).
        -->
        <javafx.version>26.0.2</javafx.version>
        <java.release>26</java.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The platform specific natives (glass.dll, ...) come with these artifacts, selected by your OS. -->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-swing</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.exlirixsoftware</groupId>
                <artifactId>tessel-fx</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${java.release}</release>
                        <showWarnings>true</showWarnings>
                        <compilerArgs>
                            <arg>-Xlint:all,-serial,-this-escape</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>0.0.8</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                    <configuration>
                        <release>${java.release}</release>
                        <encoding>UTF-8</encoding>
                        <quiet>true</quiet>
                        <!-- the sources only document public API; do not fail a release over missing comments -->
                        <doclint>all,-missing</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.7</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.8.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Builds the -sources.jar of every module. Switch it off with -P!sources. -->
        <profile>
            <id>sources</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Release to Maven Central:  mvn -Prelease clean deploy
            Needs a Central Portal user token under the server id "central" and a GPG key, see RELEASING.md.
            Adds the -javadoc.jar, signs every artifact, and uploads one bundle through the Central Portal.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- activating a profile switches off the profiles that were only active by default, so the sources
                         profile above would not run: Central requires the -sources.jar, so it is repeated here -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <!-- lets the passphrase come from -Dgpg.passphrase or MAVEN_GPG_PASSPHRASE instead of a prompt -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- false: the bundle is validated and stays in the Portal until you press Publish there -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
